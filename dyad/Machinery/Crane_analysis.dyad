"""
Stationary 2D crane: a 1000 kg load hangs from a horizontal boom and falls into the
spring cable until equilibrium. The crane base is fixed; boom angle is held at 0° (horizontal).
"""
test component CraneStaticLoad
  world = MultibodyComponents.PlanarMechanics.World(g = 9.81, render = false)
  base_fixed = MultibodyComponents.PlanarMechanics.Fixed()
  crane = Crane(PedestalHeight = 5, BoomLength = 10, BoomInitialAngle = 0, Cable_k = 1e5)
  load = MultibodyComponents.PlanarMechanics.Body(m = 1000, I = 100, render = false)
  boom_cmd = BlockComponents.Sources.Constant(k = 0)
  cable_cmd = BlockComponents.Sources.Constant(k = 8)   # initial unstretched length 8 m
relations
  initial load.r = [10, -3]
  initial load.v = [0, 0]
  connect(base_fixed.frame_b, crane.frame_a)
  connect(crane.frame_b, load.frame_a)
  connect(boom_cmd.y, crane.BoomAngle_Order)
  connect(cable_cmd.y, crane.CableLength)
end

analysis CraneTransient
  extends TransientAnalysis(stop = 5.0)
  model = CraneStaticLoad()
end
