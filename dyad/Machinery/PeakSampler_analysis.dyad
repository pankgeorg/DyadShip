"""
Drive `PeakSampler` with a sine wave. With `alpha = 0` (pure peak-hold), the output
should latch onto the first peak (~ amplitude + offset) and stay there.
"""
test component PeakSamplerSine
  sampler = PeakSampler(alpha = 0, y_start = 0)
  sine = BlockComponents.Sources.Sine(amplitude = 5, frequency = 0.5, offset = 0)
relations
  connect(sine.y, sampler.u)
end

analysis PeakSamplerTransient
  extends TransientAnalysis(stop = 10.0)
  model = PeakSamplerSine()
end
