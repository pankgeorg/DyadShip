"""
Drive `OnOffConsumer` with a square-wave duty cycle (period 60 s, 50% duty).
Starts off; turns on at t=10 s; the consumer ramps to nominal over `StartTime` s.
"""
test component OnOffConsumerDuty
  consumer = OnOffConsumer(NominalPower = 1000, Kr = 0.85, StartTime = 5)
  square = BlockComponents.Sources.Square(amplitude = 0.5, frequency = 1 / 60, offset = 0.5, start_time = 10)
relations
  connect(square.y, consumer.WorkSignal)
end

analysis OnOffConsumerTransient
  extends TransientAnalysis(stop = 120.0)
  model = OnOffConsumerDuty()
end
