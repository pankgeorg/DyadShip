"""
Verify the TemperatureDataset by connecting it to a 1 kJ/K thermal capacitor and watching
the capacitor temperature track the time-table over a 24-hour run.
"""
test component TemperatureDatasetWithCapacitor
  air = TemperatureDataset()
  cap = ThermalComponents.Components.HeatCapacitor(C = 1000, T0 = 290)
  cond = ThermalComponents.Components.ThermalConductor(G = 100)
relations
  connect(air.port_AirTemp, cond.port_a)
  connect(cond.port_b, cap.port)
end

analysis TemperatureDatasetTransient
  extends TransientAnalysis(stop = 86400.0)
  model = TemperatureDatasetWithCapacitor()
end
