"""
Solar irradiance on an inclined plane.

Ported from `ShipSIM.Components.Others.Solar.IrradiationOnPlane`.

Inputs:
- `SunVector[3]` — vector along the sun rays where its magnitude is the total irradiance
  [W/m²]. Note: it points in the direction of propagation of light, so a `-SunVector` is
  the direction *to* the sun.
- `PlaneVector[3]` — outward normal of the plane (pointing away from the surface).

Output:
- `Irradiance` — irradiance hitting the front face of the plane, clamped to ≥ 0.

Equation (same as upstream):
```math
I = \\max\\left(-\\vec{S} \\cdot \\hat{n}_{plane}, \\; 0\\right)
```
"""
component IrradiationOnPlane
  variable SunVector::Real[3]
  variable PlaneVector::Real[3]
  variable plane_norm::Real
  Irradiance = RealOutput()
  # We declare the inputs as full RealInput connectors, but Dyad doesn't support array
  # connectors well — so we expose six scalar inputs here for clarity.
  SunVector_x = RealInput()
  SunVector_y = RealInput()
  SunVector_z = RealInput()
  PlaneVector_x = RealInput()
  PlaneVector_y = RealInput()
  PlaneVector_z = RealInput()

  variable dot_neg::Real
relations
  SunVector[1] = SunVector_x
  SunVector[2] = SunVector_y
  SunVector[3] = SunVector_z
  PlaneVector[1] = PlaneVector_x
  PlaneVector[2] = PlaneVector_y
  PlaneVector[3] = PlaneVector_z

  plane_norm = sqrt(PlaneVector[1]^2 + PlaneVector[2]^2 + PlaneVector[3]^2 + 1e-12)

  dot_neg = -(SunVector[1] * PlaneVector[1] + SunVector[2] * PlaneVector[2] + SunVector[3] * PlaneVector[3]) / plane_norm

  Irradiance = ifelse(dot_neg > 0, dot_neg, 0)
end
