"""
WingSail under a constant beam wind. The sail commands a 25° angle. Forces should
develop on the sail's body-frame axes; the analysis anchors the mounting frame so the
sail forces have a node to discharge into.
"""
test component WingSailBeamWind
  sail = WingSail()
  angle_cmd = BlockComponents.Sources.Step(height = 25, start_time = 1, offset = 0)
  # No `World` needed: this test has no `Body`, only `Fixed` + `frame_a`.
  fixed = MultibodyComponents.PlanarMechanics.Fixed()
relations
  connect(angle_cmd.y, sail.Sail_Order)
  # Apparent wind: 10 m/s along the +Y body axis (beam wind from port).
  sail.WindSpeedX_in = 0
  sail.WindSpeedY_in = 10
  connect(sail.frame_a, fixed.frame_b)
end

analysis WingSailTransient
  extends TransientAnalysis(stop = 10.0)
  model = WingSailBeamWind()
end
