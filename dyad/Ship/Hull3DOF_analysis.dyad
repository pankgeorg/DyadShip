"""
Closed-loop ship simulation: propeller pushes hull, hull's surge speed feeds back into
the propeller's `ShipSpeed`. With a constant 80 kN·m torque on the shaft, the ship
accelerates from rest and the propeller's thrust balances surge drag at steady state.

The hull is now a `Hull3DOF` PlanarMechanics body with body-frame linear drag, and the
propeller is connected via `frame_a` so thrust is applied directly in 2D multibody.
"""
test component PropellerOnHull
  # PlanarMechanics requires exactly one World somewhere in the model. For a ship floating
  # on water (and a planar surge/sway/yaw model) we set g = 0 so the hull doesn't fall.
  world = MultibodyComponents.PlanarMechanics.World(g = 0, render = false)
  prop = DyadShip.Propulsion.Propeller1Q(Diameter = 4, P_D = 1.0, Ae_Ao = 0.55, Z = 4)
  shaft = RotationalComponents.Components.Inertia(J = 5000)
  src = RotationalComponents.Sources.TorqueSource()
  k_tau = BlockComponents.Sources.Constant(k = 80000)
  ground = RotationalComponents.Components.Fixed()
  hull = Hull3DOF(mass = 1e6, Iz = 1e8, Du = 5000, Dv = 1e6, Dr = 1e7)
relations
  initial shaft.phi = 0
  initial shaft.w = 0
  connect(k_tau.y, src.tau)
  connect(src.support, ground.spline)
  connect(src.spline, shaft.spline_a)
  connect(shaft.spline_b, prop.flange)

  # Connect propeller's frame to the hull body — thrust pushes the hull directly.
  connect(prop.frame_a, hull.frame_a)
  prop.ShipSpeed = hull.u

  # No external forces.
  hull.Fx_extra = 0
  hull.Fy_extra = 0
  hull.Mz_extra = 0
end

analysis PropellerOnHullTransient
  extends TransientAnalysis(stop = 200.0)
  model = PropellerOnHull()
end
