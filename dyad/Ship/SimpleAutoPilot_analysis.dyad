"""
Test harness driving `SimpleAutoPilot` with constant inputs.

The ship is at the origin with velocity along +X (0,1) m/s; the target is at (10000, 1000)
which means the ship initially has a small course offset to port. We expect the autopilot
output to settle to a positive rudder command and a positive shaft RPM that ramps the
speed module up toward `target_speed`.
"""
test component SimpleAutoPilotConstantTarget
  pilot = SimpleAutoPilot()
relations
  pilot.pos_x = 0
  pilot.pos_y = 0
  pilot.vel_x = 1
  pilot.vel_y = 0
  pilot.target_x = 10000
  pilot.target_y = 1000
  pilot.target_speed = 5
end

analysis SimpleAutoPilotTransient
  extends TransientAnalysis(stop = 5.0)
  model = SimpleAutoPilotConstantTarget()
end
