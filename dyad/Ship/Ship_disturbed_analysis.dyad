"""
Closed-loop ship under wind and sea-state disturbances. Same hull / propeller /
rudder / autopilot stack as `FullShip`, with:

- Constant world-frame wind (15 m/s from the NE, i.e. +Y/+X), routed through
  `ApparentSpeedXY` and `ShipWind` so the apparent wind seen by the
  superstructure tracks the ship's heading and motion.
- Sea state approximated as low-frequency sinusoidal disturbance forces and
  yaw moment fed into the hull's `Fx_extra`/`Fy_extra`/`Mz_extra`. Amplitudes
  are loosely Beaufort 5/6 (≈ 100 kN / 2 MN·m wave drift).

This analysis is the regression test for the autopilot — it should keep the
ship on heading and reach the waypoint despite the disturbance.
"""
test component FullShipDisturbed
  parameter target_x::Length = 10000
  parameter target_y::Length = 1000
  parameter base_torque::Torque = 80000

  world = MultibodyComponents.PlanarMechanics.World(g = 0, render = false)
  hull = HullMMG(mass = 1e6, Iz = 1e8, Lpp = 100, B = 20, Draft = 4, Cb = 0.693)

  prop = DyadShip.Propulsion.Propeller1Q(Diameter = 4, P_D = 1.0, Ae_Ao = 0.55, Z = 4)
  shaft = RotationalComponents.Components.Inertia(J = 5000)
  src = RotationalComponents.Sources.TorqueSource()
  ground = RotationalComponents.Components.Fixed()

  rudder = DyadShip.Propulsion.Rudder()
  pilot = HeadingAutoPilot(k_p = 30, k_i = 1, Deadband = π / 180)

  prop_arm = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [-50, 0], render = false)
  rudder_arm = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [-52, 0], render = false)

  # Wind chain: constant world-frame wind → apparent-speed converter → ShipWind force.
  env = DyadShip.Environment(WindSpeed = 15, WindDirection = 45)
  apparent = DyadShip.ApparentSpeedXY()
  wind = ShipWind()

  # Sea-state disturbances (wave drift). Periods 16-25 s, amplitudes ~100 kN / 2 MN·m.
  swell_x = BlockComponents.Sources.Sine(amplitude = 80000, frequency = 0.05, offset = 0, phase = 0, start_time = 0)
  swell_y = BlockComponents.Sources.Sine(amplitude = 120000, frequency = 0.04, offset = 0, phase = 1.05, start_time = 0)
  swell_yaw = BlockComponents.Sources.Sine(amplitude = 2.5e6, frequency = 0.06, offset = 0, phase = 0.78, start_time = 0)

  variable wind_world_x::Velocity
  variable wind_world_y::Velocity
relations
  initial shaft.phi = 0
  initial shaft.w = 0

  # Mechanical shaft.
  src.tau = base_torque * pilot.throttle
  connect(src.support, ground.spline)
  connect(src.spline, shaft.spline_a)
  connect(shaft.spline_b, prop.flange)

  # Hull → arms → force-appliers (prop, rudder, wind at hull CG).
  connect(hull.frame_a, prop_arm.frame_a, rudder_arm.frame_a, wind.frame_a)
  connect(prop_arm.frame_b, prop.frame_a)
  connect(rudder_arm.frame_b, rudder.frame_a)

  # Apparent wind (world → body), then into ShipWind.
  wind_world_x = env.WindVector[1]
  wind_world_y = env.WindVector[2]
  apparent.BodyVelX = hull.vx_world
  apparent.BodyVelY = hull.vy_world
  apparent.BodyHeading = hull.psi
  apparent.WorldSpeedX = wind_world_x
  apparent.WorldSpeedY = wind_world_y
  wind.ApparentWind = apparent.ApparentSpeed
  wind.AttackAngle = apparent.AttackAngleSigned

  # Sea state: feed sinusoidal forces and moment into the hull extras.
  hull.Fx_extra = swell_x.y
  hull.Fy_extra = swell_y.y
  hull.Mz_extra = swell_yaw.y

  # Propeller and rudder I/O (same as FullShip).
  prop.ShipSpeed = hull.u
  rudder.WaterSpeedX_in = hull.u
  rudder.WaterSpeedY_in = hull.v
  rudder.Propeller_speed = prop.Propeller_speed
  rudder.Propeller_flow_diameter = prop.Propeller_flow_diameter
  rudder.Wake_Fraction = prop.Wake_Fraction

  pilot.pos_x = hull.pos_x
  pilot.pos_y = hull.pos_y
  pilot.psi = hull.psi
  pilot.target_x = target_x
  pilot.target_y = target_y
  connect(pilot.rudder, rudder.Rudder_Order)
end

analysis ShipDisturbedTransient
  extends TransientAnalysis(stop = 3600.0)
  model = FullShipDisturbed()
end
