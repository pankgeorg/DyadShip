"""
Full multibody ship analysis: hull + propeller + rudder + autopilot, with PlanarMechanics
2D coupling. The propeller pushes the hull forward, the autopilot commands a rudder
deflection to steer the hull toward a target waypoint, the rudder applies a yaw moment.

Setup:
- Hull: 1e6 kg, Iz = 1e8 kg·m², linear surge/sway/yaw drag.
- Propeller driven by a constant 80 kN·m torque source, mounted 50 m aft of CG.
- Rudder mounted 52 m aft of CG (just behind the propeller). Forces from each
  device pass through a `FixedTranslation` so the lever-arm yaw moment is
  applied to the hull (in addition to the device's own hydrodynamic moment).
- Autopilot tracks (10000, 1000) with target speed 5 m/s.
- Rudder: 7 m² area, no propeller slipstream (slipstream blending is parameterized but
  the rudder receives the ship's frame velocity directly through the WaterSpeed inputs).

Expected: hull moves toward the target, rudder modulates heading, surge speed climbs
toward the target.
"""
test component FullShip
  world = MultibodyComponents.PlanarMechanics.World(g = 0, render = false)
  # Linear + quadratic surge drag. Du_quad = 4000 makes total surge resistance
  # ~125 kN at u = 5 m/s, matching the ~122 kN propeller thrust → steady-state
  # surge near 5 m/s instead of the unphysical 24 m/s the linear-only model
  # allowed. Sway gets a similar quadratic term (broadside drag ≫ surge).
  # MMG (Mathematical Maneuvering Group) hull — full surge/sway/yaw
  # cross-coupling and hydrodynamic derivatives derived from hull form.
  # Replaces the decoupled linear+quadratic Hull3DOF model. See
  # INVESTIGATION_yaw_resistance.md and HullMMG.dyad for details.
  hull = HullMMG(mass = 1e6, Iz = 1e8, Lpp = 100, B = 20, Draft = 4, Cb = 0.693)

  prop = DyadShip.Propulsion.Propeller1Q(Diameter = 4, P_D = 1.0, Ae_Ao = 0.55, Z = 4)
  shaft = RotationalComponents.Components.Inertia(J = 5000)
  src = RotationalComponents.Sources.TorqueSource()
  k_tau = BlockComponents.Sources.Constant(k = 80000)
  ground = RotationalComponents.Components.Fixed()

  rudder = DyadShip.Propulsion.Rudder()
  # PI on heading directly — replaces the previous PD-on-velocity-direction
  # autopilot. See HeadingAutoPilot.dyad. With the MMG hull's correct
  # damping the proportional gain can be moderate; the integral term lets
  # the autopilot hold a steady course against persistent disturbances.
  pilot = HeadingAutoPilot(k_p = 30, k_i = 1, Deadband = 0.0175)

  # Mounting offsets aft of the hull CG. With Lpp = 100 m (Rudder default), the
  # propeller sits at the aft perpendicular and the rudder just behind it. The
  # FixedTranslation components carry the lever-arm contribution from each
  # device's force into the hull's yaw equation — without them, only the
  # device's hydrodynamic moment (rudder Cm, propeller torque) reaches the hull.
  prop_arm = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [-50, 0], render = false)
  rudder_arm = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [-52, 0], render = false)
relations
  initial shaft.phi = 0
  initial shaft.w = 0

  # Mechanical shaft: torque source → inertia → propeller load.
  connect(k_tau.y, src.tau)
  connect(src.support, ground.spline)
  connect(src.spline, shaft.spline_a)
  connect(shaft.spline_b, prop.flange)

  # Hull CG fans out to each force-applier through its own FixedTranslation.
  connect(hull.frame_a, prop_arm.frame_a, rudder_arm.frame_a)
  connect(prop_arm.frame_b, prop.frame_a)
  connect(rudder_arm.frame_b, rudder.frame_a)

  # Propeller surge speed in body frame (same as hull.u).
  prop.ShipSpeed = hull.u

  # Rudder receives water flow in the body frame (-hull.u for X, -hull.v for Y, since the
  # convention in Rudder is "water moving past the rudder" — opposite of body velocity).
  rudder.WaterSpeedX_in = hull.u
  rudder.WaterSpeedY_in = hull.v
  rudder.Propeller_speed = prop.Propeller_speed
  rudder.Propeller_flow_diameter = prop.Propeller_flow_diameter
  rudder.Wake_Fraction = prop.Wake_Fraction

  # Autopilot reads heading + position directly.
  pilot.pos_x = hull.pos_x
  pilot.pos_y = hull.pos_y
  pilot.psi = hull.psi
  pilot.target_x = 10000
  pilot.target_y = 1000
  connect(pilot.rudder, rudder.Rudder_Order)

  # No external disturbance.
  hull.Fx_extra = 0
  hull.Fy_extra = 0
  hull.Mz_extra = 0
end

analysis ShipTransient
  extends TransientAnalysis(stop = 3600.0)
  model = FullShip()
end
