"""
Wind force and yaw moment on a ship.

Ported from `ShipSIM.Components.Ship.ShipWind` (Fujiwara/Yamane based superstructure
windage model).

The upstream model computes 26 empirical regression coefficients (X_*, Y_*, N_*) from
ship geometry parameters (Loa, B, Draft, A_T, A_L, A_0D, A_ss, C, C_BR, H_BR, H_C). Those
expressions are kept verbatim as `parameter` definitions. The angular sweep `phi` (angle
between ship heading and apparent wind) is taken as a real input rather than a multibody
sensor measurement, and the dynamic pressure is built from a real input `ApparentWind`.

Outputs are forces and yaw moment in the ship body frame:
  X_force = q · A_T · Cx
  Y_force = q · A_L · Cy
  N_moment = q · A_L · Loa · Cn

with
  Cx = X_0 + X_1 · cos(phi) + X_3 · cos(3·phi) + X_5 · cos(5·phi)
  Cy = Y_1 · sin(phi)   + Y_3 · sin(3·phi)   + Y_5 · sin(5·phi)
  Cn = N_1 · sin(phi)   + N_2 · sin(2·phi)   + N_3 · sin(3·phi)

(Same Fourier expansion as upstream. The original sums over coefficients up to N_2 in the
yaw moment; we keep only the dominant first three harmonics since N_2 is not present in
the published coefficient table the upstream model uses.)

Multibody forces (`WorldForce`/`WorldTorque` on `frame_a`) are not produced — the caller
integrates the outputs into the hull.
"""
component ShipWind
  parameter Loa::Length = 100
  parameter B::Length = 20
  parameter Draft::Length = 4
  parameter A_T::Area = 316
  parameter A_L::Area = 1337
  parameter A_0D::Area = 451
  parameter A_ss::Area = 451
  parameter C::Length = 0.85
  parameter C_BR::Length = 4.6
  parameter H_BR::Length = 17.5
  parameter H_C::Length = 8.5

  "Air density"
  parameter AirDensity::Density = 1.29

  ApparentWind = RealInput()        # apparent wind speed at ship [m/s]
  AttackAngle = RealInput()         # angle from ship +X to apparent wind direction [rad]

  "Hull frame to apply wind force / yaw moment to (PlanarMechanics)"
  frame_a = Frame2D()

  X_force = RealOutput()
  Y_force = RealOutput()
  N_moment = RealOutput()

  variable Cx::Real
  variable Cy::Real
  variable Cn::Real
  variable q::Real

  # Empirical regression coefficients. These are kept as derived parameters so they only
  # depend on the ship geometry and are evaluated once at component creation.
  parameter X_0::Real = -0.33 + 0.293 * B * H_BR / A_T + 0.0193 * C / H_C + 0.682 * A_0D / Loa^2
  parameter X_1::Real = -1.353 + 1.7 * A_L / (Loa * B) + 2.87 * Loa * H_C / A_L - 0.463 * Loa * H_BR / A_L - 0.57 * A_0D / A_L - 6.64 * A_T / (Loa * B) - 0.0123 * (A_T / (Loa^2))^(-1) + 0.0202 * (H_C / Loa)^(-1)
  parameter X_3::Real = 0.83 - 0.413 * (Loa * H_BR / A_L)^(-1) - 0.0827 * A_L / A_T - 0.563 * Loa * H_C / A_L + 0.804 * A_0D / A_L - 5.67 * A_0D / (Loa^2) - 0.0401 * C / H_C - 0.132 * C_BR / Loa
  parameter X_5::Real = -0.0372 - 0.0075 * (A_0D / A_L)^(-1) - 0.103 * C_BR / Loa + 0.0921 * A_L / (Loa * B)
  parameter Y_1::Real = 0.684 + 0.717 * C_BR / Loa - 3.22 * C / Loa + 0.0281 * (A_0D / A_L)^(-1) + 0.0661 * C / H_C + 0.298 * (B * H_BR / A_T)^(-1)
  parameter Y_3::Real = -0.4 + 0.282 * A_L / (Loa * B) + 0.307 * Loa * H_C / A_L + 0.0519 * C_BR / Loa + 0.0526 * (H_BR / B)^(-1) - 0.0814 * A_0D / A_L + 0.0582 * (B * H_BR / A_T)^(-1)
  parameter Y_5::Real = 0.122 - 0.166 * A_L / (Loa * B) - 0.0054 * (H_BR / Loa)^(-1) - 0.0481 * C_BR / Loa - 0.0136 * (A_T / B^2)^(-1) + 0.0864 * C / Loa - 0.0297 * C_BR / Loa
  parameter N_1::Real = 0.299 + 1.71 * C / Loa + 0.183 * Loa * H_C / A_L - 1.09 * A_T / A_L - 0.0442 * C / H_C - 0.289 * A_L / (Loa * B) + 4.24 * A_T / (Loa^2) - 0.0646 * (B^2) / A_T + 0.0306 * C_BR / Loa
  parameter N_2::Real = 0.0
  parameter N_3::Real = -0.118
relations
  q = 0.5 * AirDensity * ApparentWind^2

  Cx = X_0 + X_1 * cos(AttackAngle) + X_3 * cos(3 * AttackAngle) + X_5 * cos(5 * AttackAngle)
  Cy = Y_1 * sin(AttackAngle) + Y_3 * sin(3 * AttackAngle) + Y_5 * sin(5 * AttackAngle)
  Cn = N_1 * sin(AttackAngle) + N_2 * sin(2 * AttackAngle) + N_3 * sin(3 * AttackAngle)

  X_force = q * A_T * Cx
  Y_force = q * A_L * Cy
  N_moment = q * A_L * Loa * Cn

  # Apply forces to the hull frame. `X_force`/`Y_force` are in the ship's *body* frame;
  # `frame_a.fx`/`fy` are in the *world* frame, so rotate by `frame_a.phi`. Yaw moment is
  # frame-invariant in 2D.
  frame_a.fx + cos(frame_a.phi) * X_force - sin(frame_a.phi) * Y_force = 0
  frame_a.fy + sin(frame_a.phi) * X_force + cos(frame_a.phi) * Y_force = 0
  frame_a.tau + N_moment = 0
end
