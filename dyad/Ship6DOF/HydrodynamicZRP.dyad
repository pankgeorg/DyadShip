"""
Heave / roll / pitch hydrodynamic damping and added mass acting on a 3D frame.

Port of `ShipSIM.Components.Ship.HidrodynamicZRP`, which upstream is a
placeholder with every coefficient defaulting to zero. Connect `frame_a` to
the `ShipBody` reference frame and feed `MeanDraft` / `Displacement` from its
outputs. Velocities are taken at the centre of forces `[Lpp/2, 0, MeanDraft/2]`.

Each vertical-plane degree of freedom gets a linear plus quadratic damping
term and a constant added-mass term:

```math
Z = -B_z w - Z_d\\, w |w| - \\Delta m_z \\dot w, \\quad
K = -B_\\phi p - R_d\\, p |p| - \\Delta J_r \\dot p, \\quad
M = -B_\\theta q - P_d\\, q |q| - \\Delta J_p \\dot q
```

The linear coefficients default to a fraction `zeta_*` of critical damping,
estimated from the hydrostatic stiffness of a hull with waterplane
`Cw · Lpp · B`, metacentric heights `GM` / `GM_L`, and radii of gyration
`k_xx` / `k_yy`. Override `B_heave` / `B_roll` / `B_pitch` directly when
measured or Ikeda-type values are available. Upstream applied the roll
damping coefficient and roll rate to the pitch axis (copy-paste error); the
pitch axis here uses its own coefficient and rate.
"""
component HydrodynamicZRP
  frame_a = Frame3D()
  "Instantaneous mean draft from ShipBody"
  MeanDraft = RealInput()
  "Instantaneous displacement mass from ShipBody"
  Displacement = RealInput()

  force = MultibodyComponents.WorldForce(resolve_in_frame = MultibodyComponents.ResolveInFrame.FrameB(), render = false)
  torque = MultibodyComponents.WorldTorque(resolve_in_frame = MultibodyComponents.ResolveInFrame.FrameB())

  parameter Lpp::Length = 100
  parameter B::Length = 20
  "Design mass used for the default damping estimates"
  parameter mass::Mass = 5681200
  "Waterplane coefficient"
  parameter Cw::Real = 0.85
  "Transverse metacentric height"
  parameter GM::Length = 2.9
  "Longitudinal metacentric height"
  parameter GM_L::Length = 170
  "Roll radius of gyration"
  parameter k_xx::Length = 0.3557 * B
  "Pitch radius of gyration"
  parameter k_yy::Length = 0.2746 * Lpp
  parameter SeaDensity::Density = 1025
  parameter g::Acceleration = 9.80665
  "Heave damping ratio for the default linear coefficient"
  parameter zeta_heave::Real = 0.2
  "Roll damping ratio for the default linear coefficient"
  parameter zeta_roll::Real = 0.05
  "Pitch damping ratio for the default linear coefficient"
  parameter zeta_pitch::Real = 0.2
  "Linear heave damping [N s/m]"
  parameter B_heave::Real = 2 * zeta_heave * sqrt(SeaDensity * g * Cw * Lpp * B * mass)
  "Linear roll damping [N m s]"
  parameter B_roll::Real = 2 * zeta_roll * sqrt(mass * g * GM * mass * k_xx^2)
  "Linear pitch damping [N m s]"
  parameter B_pitch::Real = 2 * zeta_pitch * sqrt(mass * g * GM_L * mass * k_yy^2)
  "Quadratic heave damping [N s²/m²]"
  parameter Z_d::Real = 0
  "Quadratic roll damping [N m s²]"
  parameter R_d::Real = 0
  "Quadratic pitch damping [N m s²]"
  parameter P_d::Real = 0
  "Heave added-mass fraction of displacement"
  parameter mz::Real = 0
  "Roll added inertia per unit displacement [m²]"
  parameter Jr::Real = 0
  "Pitch added inertia per unit displacement [m²]"
  parameter Jp::Real = 0

  variable r_cof::Length[3]
  variable v_frame::Velocity[3]
  variable w::AngularVelocity[3]
  variable v_cof::Velocity[3]
  "Heave velocity at the centre of forces"
  variable w_h::Velocity
  variable p::AngularVelocity
  variable q::AngularVelocity
  variable Z::Force
  variable K::Torque
  variable M::Torque
  variable tau::Torque[3]
relations
  connect(frame_a, force.frame_b, torque.frame_b)

  r_cof = [Lpp / 2, 0, MeanDraft / 2]
  v_frame = MultibodyComponents.resolve2(frame_a.R, der(frame_a.r_0))
  w = MultibodyComponents.angular_velocity2(frame_a.R)
  v_cof = v_frame + MultibodyComponents.cross(w, r_cof)
  w_h = v_cof[3]
  p = w[1]
  q = w[2]

  Z = -B_heave * w_h - Z_d * w_h * abs(w_h) - Displacement * mz * der(w_h)
  K = -B_roll * p - R_d * p * abs(p) - Displacement * Jr * der(p)
  M = -B_pitch * q - P_d * q * abs(q) - Displacement * Jp * der(q)

  tau = MultibodyComponents.cross(r_cof, [0, 0, Z]) + [K, M, 0]
  force.force_x = 0
  force.force_y = 0
  force.force_z = Z
  torque.torque_x = tau[1]
  torque.torque_y = tau[2]
  torque.torque_z = tau[3]
end
